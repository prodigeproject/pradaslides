{
  "schema_version": "1.1",
  "name": "Editorial executive default",
  "direction": {
    "communication_mode": "hybrid",
    "visual_cluster": "corporate-editorial",
    "character": ["clear", "confident", "crafted"],
    "reference_principles": [
      "one unmistakable focal point per slide",
      "large display type paired with compact support copy",
      "light-dark section rhythm",
      "evidence shown at useful scale",
      "coherent identity without repeated card grids"
    ],
    "avoid": [
      "generic title-and-bullets",
      "dashboard-like card walls",
      "tiny screenshots",
      "decorative diagrams",
      "weak contrast",
      "marketplace-layout cloning"
    ]
  },
  "canvas": {
    "aspect_ratio": "16:9",
    "width_px": 1600,
    "height_px": 900,
    "safe_margin_px": 72,
    "columns": 12,
    "gutter_px": 24,
    "baseline_px": 8
  },
  "typography": {
    "display_family": "Aptos Display, Inter, Arial, sans-serif",
    "body_family": "Aptos, Inter, Arial, sans-serif",
    "mono_family": "IBM Plex Mono, Consolas, monospace",
    "fallback_policy": "system-font-safe",
    "selection": {
      "category_prior": "corporate-editorial",
      "product_archetype": "executive decision presentation",
      "positioning": "crafted, credible, and direct",
      "audience": "decision makers reviewing evidence and a bounded next action",
      "personality": ["clear", "confident", "crafted"],
      "proof_density": "balanced narrative and evidence",
      "interaction_model": "hybrid spoken presentation and review",
      "rationale": "Use a confident display sans, neutral readable body, and precise mono labels because the audience needs fast claims, inspectable proof, and unambiguous sources without a generic dashboard tone."
    },
    "sizes_px": {
      "hero": 88,
      "headline": 54,
      "subhead": 32,
      "body": 25,
      "caption": 18,
      "micro": 14
    },
    "max_headline_lines": 3,
    "max_body_line_length_characters": 62,
    "body_line_height": 1.28
  },
  "color": {
    "accent": "#F15A3A",
    "positive": "#1F9D78",
    "warning": "#D89A2B",
    "negative": "#C84242",
    "tones": {
      "light": {
        "background": "#F2EEE6",
        "surface": "#FFFFFF",
        "text": "#171817",
        "muted": "#6E706C",
        "line": "#CEC8BD"
      },
      "dark": {
        "background": "#111311",
        "surface": "#1D201D",
        "text": "#F7F1E8",
        "muted": "#A8AAA4",
        "line": "#3A3E39"
      },
      "accent": {
        "background": "#F15A3A",
        "surface": "#E34D30",
        "text": "#171817",
        "muted": "#4A251D",
        "line": "#B73A25"
      }
    }
  },
  "furniture": {
    "default_enabled": ["kicker", "page-number", "progress", "frame-corners"],
    "optional": ["section-rail", "ghost-marker", "metric-strip", "page-hint", "source-line"],
    "max_decorative_motifs_per_slide": 2,
    "chrome_must_not_compete_with_claim": true
  },
  "rhythm": {
    "min_distinct_topologies_per_10_slides": 5,
    "max_consecutive_same_topology": 2,
    "max_consecutive_same_tone": 3,
    "min_tone_shifts_per_10_slides": 2,
    "max_card_grid_ratio": 0.25,
    "preferred_emphasis_sequence": ["claim", "evidence", "claim", "mechanism", "proof", "decision"]
  },
  "quality_floor": {
    "thumbnail_test": "Primary hierarchy and deck rhythm remain visible at 12 percent scale",
    "squint_test": "One focal region is unmistakable before copy is read",
    "evidence_scale": "Proof objects are large enough to inspect rather than merely decorate",
    "contrast": "Text and critical marks meet WCAG AA where applicable",
    "copy_fit": "No headline wraps beyond its budget and no body is shrunk to solve overflow",
    "reference_floor": "Visual identity, layout variation, and evidence staging must be at least as deliberate as the relevant supplied reference cluster",
    "target_runtime": "Final visuals must be inspected in the requested delivery runtime"
  }
}
